#!/usr/bin/env python3
"""rx —— 具名 reasonix 执行者，状态自动续接，调度者不用管 session id。

    rx spawn <名字> "任务"  [--dir D] [--model M] [--timeout S]    新建执行者并派第一个任务
    rx ask   <名字|session_id|会话路径> "追问"  [--copy] [--timeout S]  让它接着上次的上下文干
    rx adopt <名字> <session_id|会话路径>       把已有会话（如 acp_pool 产出的）收编成具名执行者
    rx ls                                       看所有执行者
    rx show  <名字>                             看它的会话文件和最近产出
    rx rm    <名字>                             删掉登记（不删会话文件）

默认给每轮 prompt 追加无人值守守则（guard.md），用 --no-guard 关掉。
--copy：会话被其他 reasonix 进程占用（lease 冲突）时，复制一份会话继续（reasonix run --copy）。
--timeout：reasonix 单次运行超时秒数（默认 3600），超时后杀掉子进程并给出清晰报错。
"""
import argparse, json, os, pathlib, subprocess, sys

HOME = pathlib.Path(os.environ.get("RX_HOME", pathlib.Path.home() / ".reasonix-crew"))
GUARD = pathlib.Path(__file__).parent / "guard.md"
RX_BASES = [pathlib.Path.home() / ".reasonix" / "projects",
            pathlib.Path.home() / ".reasonix" / "sessions"]
DEFAULT_TIMEOUT = 3600.0

def reg(name): return HOME / f"{name}.json"

def load_guard(off):
    if off or not GUARD.exists(): return ""
    return "\n\n---\n\n" + GUARD.read_text().strip()

def project_sessions_dir(cwd):
    """把工作目录映射到 reasonix 的 project 会话目录（实测规则：去前导 /、/ → -）。
    映射规则失效（目录不存在）时返回 None，调用方退回全局搜索。"""
    if not cwd:
        return None
    name = "-" + str(cwd).lstrip("/").replace("/", "-")
    d = pathlib.Path.home() / ".reasonix" / "projects" / name / "sessions"
    return d if d.is_dir() else None

def find_session(sid, cwd=None):
    """定位 {sid}.jsonl 会话文件。
    F13：已知工作目录时先在对应 project 目录精确找（唯一命中即返回）；
    否则全局搜索，多个候选时报告歧义并列出全部候选，而不是闷头取第一个。"""
    pd = project_sessions_dir(cwd)
    if pd:
        hits = sorted(pd.rglob(f"{sid}.jsonl"))
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            sys.exit(f"会话 {sid} 在项目目录 {pd} 下存在多个候选，无法确定用哪个：\n"
                     + "\n".join(f"  {h}" for h in hits))
    cands = []
    for base in RX_BASES:
        if base.is_dir():
            cands.extend(base.rglob(f"{sid}.jsonl"))
    if len(cands) == 1:
        return cands[0]
    if len(cands) > 1:
        sys.exit(f"会话 {sid} 存在多个候选文件，无法确定用哪个（可用完整 .jsonl 路径消除歧义）：\n"
                 + "\n".join(f"  {c}" for c in cands))
    return None

def read_reg(name):
    """F14：读登记文件；不存在/损坏/缺必要键都给清晰报错而非 traceback。"""
    path = reg(name)
    try:
        meta = json.loads(path.read_text())
    except FileNotFoundError:
        sys.exit(f"没有叫 {name} 的执行者（登记文件 {path} 不存在）")
    except (json.JSONDecodeError, UnicodeDecodeError, OSError) as e:
        sys.exit(f"登记文件 {path} 损坏或不可读（{e}）；可先 rx rm {name} 再重建")
    if not isinstance(meta, dict):
        sys.exit(f"登记文件 {path} 格式错误：应为 JSON 对象，实际是 {type(meta).__name__}")
    missing = [k for k in ("session", "session_id", "dir") if k not in meta]
    if missing:
        sys.exit(f"登记文件 {path} 缺少必要字段 {missing}；可先 rx rm {name} 再重建")
    return meta

def write_reg(name, meta):
    """F14：原子写登记：同目录临时文件 + os.replace，避免写一半被杀导致损坏。"""
    path = reg(name)
    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(meta, ensure_ascii=False, indent=2))
    os.replace(tmp, path)

def resolve(handle, cwd=None):
    """handle 可以是登记名、裸 session id、或会话文件路径。返回 (meta, 登记名或 None)。"""
    if reg(handle).exists():
        return read_reg(handle), handle
    p = pathlib.Path(handle)
    if p.suffix == ".jsonl" and p.exists():
        return {"session": str(p), "session_id": p.stem, "dir": os.getcwd(), "turns": 0}, None
    f = find_session(handle, cwd=cwd or os.getcwd())
    if f:
        return {"session": str(f), "session_id": handle, "dir": os.getcwd(), "turns": 0}, None
    sys.exit(f"无法解析句柄 {handle!r}：既不是已登记的名字，也找不到对应会话文件")

def call(args, task, resume=None, want_json=False):
    cmd = ["reasonix", "run", "--dir", args["dir"], "--permission-mode", args.get("perm", "auto")]
    if args.get("model"): cmd += ["--model", args["model"]]
    if resume: cmd += ["--resume", str(resume)]
    if args.get("copy"): cmd += ["--copy"]
    if want_json:
        cmd += ["--output-format", "json"]
    else:
        cmd += ["-p"]
    cmd.append(task)
    timeout = args.get("timeout") or DEFAULT_TIMEOUT
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        # F10：超时后 run 已杀掉子进程；给出清晰报错而非无限挂起
        sys.exit(f"reasonix 运行超过 {timeout:g}s 未返回，已终止子进程；可用 --timeout 调大后重试")
    except FileNotFoundError:
        sys.exit("reasonix 未找到：请确认 reasonix 已安装且在 PATH 中（可用 `reasonix --version` 验证）")
    if r.returncode != 0:
        err = ((r.stderr or "") + (r.stdout or "")).strip()
        if "in use by another Reasonix process" in err:
            # F11：lease 冲突——识别并给出明确处置，不静默失败
            sys.exit(f"会话正被另一个 reasonix 进程占用（lease 冲突）：{err[:300]}\n"
                     f"处置：等对方结束该会话后重试；或加 --copy 复制一份会话继续（原会话保持不动）")
        sys.exit(f"reasonix 失败：{err[:800] or '(无输出)'}")
    return r.stdout

def claim(name):
    """F11：原子占用登记名（O_EXCL），消除 spawn/adopt「先 exists 检查再写」的 TOCTOU。"""
    path = reg(name)
    try:
        return os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        sys.exit(f"执行者 {name} 已存在，用 rx ask 继续，或 rx rm 后重建")

def release(fd, name, keep=False):
    os.close(fd)
    if not keep:
        try:
            reg(name).unlink()
        except OSError:
            pass

def cmd_spawn(a):
    HOME.mkdir(parents=True, exist_ok=True)
    fd = claim(a.name)
    meta = {"dir": str(pathlib.Path(a.dir).resolve()), "model": a.model, "perm": a.perm,
            "timeout": a.timeout}
    try:
        out = call(meta, a.task + load_guard(a.no_guard), want_json=True)
    except SystemExit:
        release(fd, a.name)   # 失败：清掉占位，不留空登记
        raise
    try:
        res = json.loads(out.strip().splitlines()[-1])
    except Exception:
        release(fd, a.name)
        sys.exit(f"解析 reasonix 输出失败：{out[:400]}")
    sess = find_session(res["session_id"], cwd=meta["dir"])
    if not sess:
        release(fd, a.name)
        sys.exit(f"找不到会话文件 {res['session_id']}.jsonl")
    meta.update(session=str(sess), session_id=res["session_id"], turns=1,
                cost=res.get("total_cost_usd", 0))
    write_reg(a.name, meta)   # 原子替换占位文件
    release(fd, a.name, keep=True)
    print(res.get("result", ""))
    print(f"\n[{a.name}] session_id={meta['session_id']}\n[{a.name}] session={meta['session']}\n"
          f"[{a.name}] 第 1 轮 · 累计 US${meta['cost']:.4f}", file=sys.stderr)

def cmd_ask(a):
    meta, name = resolve(a.name)
    run_args = dict(meta)
    run_args["timeout"] = a.timeout if a.timeout is not None else meta.get("timeout", DEFAULT_TIMEOUT)
    run_args["copy"] = a.copy
    out = call(run_args, a.task + load_guard(a.no_guard), resume=meta["session"], want_json=True)
    try:
        res = json.loads(out.strip().splitlines()[-1])
    except Exception:
        sys.exit(f"解析 reasonix 输出失败：{out[:400]}")
    meta["turns"] = meta.get("turns", 0) + 1
    meta["cost"] = round(meta.get("cost", 0) + res.get("total_cost_usd", 0), 6)
    if name:
        write_reg(name, meta)
    print(res.get("result", ""))
    tag = name or meta["session_id"]
    print(f"\n[{tag}] session_id={meta['session_id']}\n"
          f"[{tag}] 第 {meta['turns']} 轮 · 累计 US${meta['cost']:.4f}", file=sys.stderr)

def cmd_adopt(a):
    """把已有会话（如 acp_pool 产出的 sessionId/transcriptPath）登记成具名执行者。"""
    HOME.mkdir(parents=True, exist_ok=True)
    fd = claim(a.name)
    try:
        meta, _ = resolve(a.session, cwd=str(pathlib.Path(a.dir).resolve()))
    except SystemExit:
        release(fd, a.name)
        raise
    meta["dir"] = str(pathlib.Path(a.dir).resolve())
    meta.setdefault("model", a.model); meta.setdefault("perm", a.perm)
    meta.setdefault("cost", 0.0); meta.setdefault("timeout", a.timeout)
    write_reg(a.name, meta)
    release(fd, a.name, keep=True)
    print(f"已收编 {a.name} → session_id={meta['session_id']}\n  {meta['session']}")


def cmd_ls(a):
    if not HOME.exists() or not any(HOME.glob("*.json")): return print("还没有执行者")
    print(f"{'名字':<12}{'轮次':<5}{'累计成本':<11}{'session_id':<44}{'工作目录'}")
    for p in sorted(HOME.glob("*.json")):
        try:
            m = json.loads(p.read_text())
        except Exception as e:
            # F14：单个登记损坏不拖垮 ls——警告后跳过该行
            print(f"{p.stem:<12}<登记损坏，跳过: {e}>", file=sys.stderr)
            continue
        print(f"{p.stem:<12}{m.get('turns',0):<5}US${m.get('cost',0):<8.4f}  "
              f"{m.get('session_id','?'):<44}{m.get('dir','?')}")

def cmd_show(a):
    m = read_reg(a.name)   # 损坏/缺键 → 清晰报错
    print(json.dumps(m, ensure_ascii=False, indent=2))

def cmd_rm(a):
    if reg(a.name).exists(): reg(a.name).unlink(); print(f"已删除登记 {a.name}（会话文件保留）")
    else: sys.exit(f"没有叫 {a.name} 的执行者")

ap = argparse.ArgumentParser(description="具名 reasonix 执行者")
sub = ap.add_subparsers(dest="cmd", required=True)
def common(p):
    p.add_argument("--dir", default=".", help="工作目录")
    p.add_argument("--model"); p.add_argument("--perm", default="auto")
    p.add_argument("--no-guard", action="store_true")
    p.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT,
                   help=f"reasonix 单次运行超时秒数（默认 {DEFAULT_TIMEOUT:g}）")
s = sub.add_parser("spawn"); s.add_argument("name"); s.add_argument("task"); common(s); s.set_defaults(f=cmd_spawn)
s = sub.add_parser("ask");   s.add_argument("name"); s.add_argument("task")
s.add_argument("--no-guard", action="store_true")
s.add_argument("--copy", action="store_true", help="会话被占用时复制一份继续（reasonix run --copy）")
s.add_argument("--timeout", type=float, default=None,
               help=f"reasonix 单次运行超时秒数（默认沿用登记值，无则 {DEFAULT_TIMEOUT:g}）")
s.set_defaults(f=cmd_ask)
s = sub.add_parser("adopt"); s.add_argument("name"); s.add_argument("session")
common(s); s.set_defaults(f=cmd_adopt)
s = sub.add_parser("ls");    s.set_defaults(f=cmd_ls)
s = sub.add_parser("show");  s.add_argument("name"); s.set_defaults(f=cmd_show)
s = sub.add_parser("rm");    s.add_argument("name"); s.set_defaults(f=cmd_rm)
a = ap.parse_args(); a.f(a)
